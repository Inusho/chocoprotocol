# === Twitch Bot Konfiguration ===
# HINWEIS: Die .env wird nur beim allerersten Start verwendet.
# Danach werden alle Einstellungen über das Dashboard verwaltet (data/settings.json).
# Du kannst die .env auch komplett weglassen und alles im Dashboard konfigurieren.

# Dein Bot-Account Name (z.B. "MeinCoolerBot")
BOT_USERNAME=

# OAuth Token für den Bot-Account
# So bekommst du eins:
# 1. Gehe zu https://dev.twitch.tv/console und erstelle eine Anwendung
#    - OAuth Redirect URL: http://localhost
#    - Kategorie: Chat Bot
# 2. Kopiere die Client-ID und öffne diese URL im Browser:
#    https://id.twitch.tv/oauth2/authorize?response_type=token&client_id=DEINE_CLIENT_ID&redirect_uri=http://localhost&scope=chat:read+chat:edit+channel:moderate
# 3. Nach dem Autorisieren steht der Token in der URL-Leiste (access_token=...)
# 4. Hier eintragen mit oauth: davor
# Format: oauth:xxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_OAUTH_TOKEN=

# Dein Twitch Kanal Name (ohne #)
CHANNEL_NAME=

# Command Prefix (Standard: !)
PREFIX=!

# === Discord Integration ===
# Webhook URL für Discord Benachrichtigungen
# So erstellst du einen Webhook:
# 1. Discord Server -> Kanal-Einstellungen -> Integrationen -> Webhooks
# 2. Neuen Webhook erstellen und URL kopieren
DISCORD_WEBHOOK_URL=

# === Twitch API (für Live-Erkennung) ===
# Brauchst du für die automatische Live-Benachrichtigung an Discord
# 1. Gehe zu https://dev.twitch.tv/console
# 2. Deine Anwendung -> Client-ID und Client Secret kopieren
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Wie oft soll der Live-Status geprüft werden? (in ms, Standard: 60000 = 1 Minute)
TWITCH_POLL_INTERVAL=60000
