      "sounds/README.txt"
    ]
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.1"
  }
}
