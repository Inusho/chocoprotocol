{
  "name": "chocoprotocol",
  "version": "1.0.0",
  "description": "Modularer Twitch Bot mit Web-Dashboard & Discord-Integration",
  "main": "bot.js",
  "bin": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "node --watch bot.js"
  },
  "pkg": {
